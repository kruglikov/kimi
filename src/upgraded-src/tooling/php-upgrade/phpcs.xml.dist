<?xml version="1.0"?>
<ruleset name="KIMI PHP Compatibility">
    <description>PHP 8.1-8.5 compatibility scan for the upgraded KIMI source tree.</description>

    <arg value="p"/>
    <arg name="colors"/>

    <config name="testVersion" value="8.1-8.5"/>

    <file>../../web/htdocs/kimi_ET</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/kimibatch/files/vendor/*</exclude-pattern>
</ruleset>
